---
interface Props { href?: string }
const { href = '/' } = Astro.props;
---
<a class="wordmark" href={href} aria-label="Pacenote home">
  <svg aria-hidden="true" focusable="false" viewBox="0 0 32 32" width="28" height="28">
    <rect width="32" height="32" rx="7" fill="var(--card-2)"/>
    <polyline points="4,22 9,22 12,11 16,24 20,9 23,22 28,22" fill="none" stroke="var(--accent)" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
  <span>Pacenote</span>
</a>
<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
    color: var(--fg);
    min-height: 44px;
  }
</style>

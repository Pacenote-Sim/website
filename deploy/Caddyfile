# pacenote.tech — static site served by Caddy.
# Copy the built site to /var/www/pacenote (the contents of dist/), then
# include this file from your main Caddyfile or paste the two blocks into it.

www.pacenote.tech {
	root * /var/www/pacenote
	encode zstd gzip

	# /docs has no page of its own.
	redir /docs /docs/getting-started/ permanent
	redir /docs/ /docs/getting-started/ permanent

	# Hashed assets never change; let browsers keep them for a year.
	@assets path /_astro/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Everything else may change on the next deploy.
	@pages not path /_astro/*
	header @pages Cache-Control "public, max-age=0, must-revalidate"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle_errors {
		@404 expression {http.error.status_code} == 404
		rewrite @404 /404.html
		file_server
	}

	file_server
}

# The bare domain sends everyone to www, keeping the path.
pacenote.tech {
	redir https://www.pacenote.tech{uri} permanent
}
